{
  "name": "oh-my-dm",
  "version": "0.7.2",
  "description": "DM without looking like you're DMing — a discreet Agent CLI-style TUI messenger.",
  "license": "Apache-2.0",
  "author": "Hyunwoo Gu <162293672+guhyunwoo@users.noreply.github.com>",
  "homepage": "https://github.com/stacking-money-forever/oh-my-dm#readme",
  "bugs": {
    "url": "https://github.com/stacking-money-forever/oh-my-dm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacking-money-forever/oh-my-dm.git"
  },
  "keywords": [
    "cli",
    "tui",
    "instagram",
    "kakaotalk",
    "messaging",
    "terminal"
  ],
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "bin": {
    "dm": "dist/cli.js",
    "oh-my-dm": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "node --import tsx src/cli.tsx",
    "graph:doctor": "cgc doctor",
    "graph:index": "cgc index .",
    "graph:reindex": "cgc index --force .",
    "graph:list": "cgc list",
    "postinstall": "node scripts/patch-ink-static-fullscreen.mjs && playwright-core install chromium --no-shell",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
